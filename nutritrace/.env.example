# Copy to .env and fill in. NEVER commit the real .env.

# Where NutriTrace keeps its database and uploads (relative to this folder)
DATA_DB_PATH=./data/db
DATA_UPLOADS_PATH=./data/uploads

# REQUIRED: a long random secret (generate one:  openssl rand -base64 48   or any 48+ random characters)
JWT_SECRET=change-me-to-a-long-random-secret

# Off by default: no calls to GitHub for update checks
UPDATE_CHECK=off

# NutriTrace lives under /food behind the proxy, and tells people the public address
BASE_URL=/food
PUBLIC_URL=https://YOUR-HOST.your-tailnet.ts.net/food

# Needed by the "Today's nutrition" card + level/quests (read-only token, scope mcp:read, created in NutriTrace -> Settings -> API Tokens)
MCP_ENABLED=1

# Do NOT set INSECURE_COOKIES (only for plain-http testing).
# RECOVERY_TOKEN is only for a lockout: add it temporarily, use it once, then remove it.
